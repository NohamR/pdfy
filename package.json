{
  "name": "pdfy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Convert web articles to PDF using Reader View and Puppeteer",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node src/test/test.js"
  },
  "standard": {
